// Cloudflare Workers settings. The build (Nitro) merges these into .output/server/wrangler.json;
// the worker's name must match the project name in the Cloudflare dashboard.
{
  "name": "emfc-website",
  "compatibility_flags": ["nodejs_compat"],
  // Public by design (the browser gets the same values). Secrets such as RESEND_API_KEY are set in
  // the Cloudflare dashboard instead, and keep_vars stops a deploy from removing them.
  "vars": {
    "SUPABASE_URL": "https://rqgjcdttfccemcyxulub.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_3iCY-T7SSjEVAIzMlyrGHw_Mb8lNF9f"
  },
  "keep_vars": true
}
